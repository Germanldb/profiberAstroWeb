import flechaVector from "../assets/flechaVector.png";

import probasicBroadband from "../assets/BroadBand-plans/PROBASIC - BroadBand.jpg.jpeg";
import proadvanceBroadband from "../assets/BroadBand-plans/PROADVANCE - BroadBand.jpg.jpeg";
import proforceBroadband from "../assets/BroadBand-plans/PROFORCE - BroadBand.jpg.jpeg";
import proeliteBroadband from "../assets/BroadBand-plans/PROELITE - BroadBand.jpg.jpeg";
import premierBroadband from "../assets/BroadBand-plans/Premier-BroadBand.jpg.jpeg";
import basicPlusBroadband from "../assets/BroadBand-plans/Basic pluss-BroadBand .jpg.jpeg";
