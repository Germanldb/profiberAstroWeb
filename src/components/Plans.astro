  },
  {
    name: "PRO5G Boost",
    price: "$79.99",
    mb1: "150 MB",
    mb2: "30 MB",
    // updown: "UP/DOWN",
    tv: "",
    broadbandImage: pro5gBoostBroadband,
  },
  {
    name: "PRO5G Turbo",
    price: "$99.99",
    mb1: "200 MB",
    mb2: "60 MB",
    // updown: "UP/DOWN",
    tv: "",
    broadbandImage: pro5gTurboBroadband,
  },
  {
    name: "PRO5G Ultra",
    price: "$110.99",
    mb1: "350 MB",
    mb2: "80 MB",
    // updown: "UP/DOWN",
    tv: "",
    broadbandImage: pro5gUltraBroadband,
  },
];

// Sección 2 (nuevos planes)
const plansPage2 = [
  {
    name: "PROBasic",
    price: "$49.99",
    mb1: "100 MB",
    mb2: "20 MB",
    tv: "+ TV $ 89.99",
    broadbandImage: probasicBroadband,
  },
  {
    name: "PROAdVance",
    price: "$59.99",
    mb1: "300 MB",
    mb2: "60 MB",
    tv: "+ TV $ 99.99",
    broadbandImage: proadvanceBroadband,
  },
  {
    name: "PROForce",
    price: "$79.99",
    mb1: "500 MB",
    mb2: "100 MB",
    tv: "+ TV $ 119.99",
    broadbandImage: proforceBroadband,
  },
  {
    name: "PROElite",
    price: "$89.99",
    mb1: "1 GB",
    mb2: "200 MB",
    tv: "+ TV $ 129.99",
    broadbandImage: proeliteBroadband,
  },
];

// Sección 3 (nuevos planes)
const plansPage3 = [
  {
    name: "Basic",
    price: "$39.99",
    mb1: "15 MB",
    mb2: "8 MB",
    // updown: "UP/DOWN",
    tv: "",
    broadbandImage: basicPlusBroadband,
  },
  {
    name: "Premier",
    price: "$44.99",
    mb1: "25 MB",
    mb2: "10 MB",
    // updown: "UP/DOWN",
    tv: "",
    broadbandImage: premierBroadband,
  },
  {
    name: "Premier Pluss",
    price: "$49.99",
    mb1: "30 MB",
    mb2: "10 MB",
    // updown: "UP/DOWN",
    tv: "",
    broadbandImage: premierPlussBroadband,
  },
  {
    name: "PROULTRA",
    price: "$54.99",
    mb1: "50 MB",
    mb2: "20 MB",
    // updown: "UP/DOWN",
    tv: "",
    broadbandImage: proultraBroadband,
  },
  {
    name: "PRO",
    price: "$79.99",
    mb1: "100 MB",
    mb2: "30 MB",
    // updown: "UP/DOWN",
    tv: "",
