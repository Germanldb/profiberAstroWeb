];

const planPages = [plansPage2, plansPage3, plansPage1];

// src/components/Plans.astro
---

<section
  class="container mx-auto pb-20 py-2 relative overflow-hidden"
  id="plans"
>
  <!-- Decorative lightning bolts -->
  <div class="bg-white rounded-2xl py-8 relative overflow-hidden">
    <Image
      src={rayo1}
      alt={"Rayo"}
      class="absolute left-[-80px] md:left-0 top-[-50px] h-50 w-50 md:h-120 w-100"
    />
    <Image
      src={rayo2}
      alt={"Rayo"}
      class="absolute right-[-80px] md:right-0 top-[-50px] h-50 w-50 md:h-120 w-100"
    />

    <Image
      src={flechaVector}
      alt={"flecha-vector"}
      class="absolute bottom-5 right-5 h-10 w-10 z-0 opacity-80"
    />

    <div class="container mx-auto px-4 relative z-10">
      <!-- Header -->
      <div class="text-center mb-18">
        <h2 class="text-4xl text-purple-500 font-bold mt-20 mb-2">
          Estas son nuestras ofertas
        </h2>
        <div
          class="relative bg-[#8F4DEF] rounded-2xl inline-block px-8 py-4 mt-8 mb-6 overflow-hidden"
        >
          <Image
            src={bgOfertas}
            alt="bg-ofertas"
            class={"absolute inset-0 w-full h-full object-cover opacity-30 pointer-events-none"}
          />

          <h1
            id="plan-slogan"
            class="relative z-10 lg:text-6xl sm:text-4xl font-bold text-white text-center"
          >
            5G
          </h1>
        </div>
        <p class="text-[#8F4DEF] text-3xl">
          Escoge el Plan que mejor se adapte a ti:
        </p>
      </div>

      <!-- Plans Pages with pagination -->
      <div
        id="plan-pages"
        class="max-w-7xl mx-auto lg:mt-10 md:mb-9 mb-[130px]"
      >
        {
          planPages.map((page, pageIdx) => (
            <div
              class={`mb-8 gap-8 ${pageIdx === 0 ? "" : "hidden"}`}
              data-page={pageIdx}
            >
              {/* Lógica: Si la página tiene 6 elementos, aplicamos el diseño 4 + 2 */}
              {pageIdx === 1 ? (
                <>
                  {/* 1. Fila superior: 3 planes */}
                  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-12 md:gap-10 md:pb-[10px] mb-[10px] max-w-5xl mx-auto">
                    {page.slice(0, 3).map((plan, idx) => (
                      <div class="group">
                        <WirelessPlanCard
                          {...plan}
                          idx={idx}
                          total={page.length}
                        />
                      </div>
                    ))}
                  </div>

                  {/* 2. Fila inferior: 2 planes */}
                  <div class="md:flex md:justify-center lg:flex lg:justify-center sm:grid sm:grid-cols-1">
                    <div class="grid grid-cols-1 lg:mt-[40px] md:mt-[40px] sm:grid-cols-2 lg:grid-cols-2 gap-4 lg:gap-12 sm:mb-[20px] max-w-3xl mx-auto">
                      {page.slice(3).map((plan, idx) => (
                        <div class="group">
                          <WirelessPlanCard
                            {...plan}
                            idx={idx + 3}
                            total={page.length}
                          />
                        </div>
                      ))}
                    </div>
                  </div>
                </>
              ) : (
                // Lógica para cualquier otra página (con 4 o más elementos)
                // Si hay paginación, esta es la forma de mostrar las páginas > 0
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 md:gap-8 lg:gap-8 pb-10">
                  {page.map((plan, idx) => (
                    <div>
                      <div class="group">
                        <PlanCard {...plan} idx={idx} total={page.length} />
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>
          ))
        }
      </div>

      <!-- Controls -->
      <div
        id="plan-controls"
        class="flex items-center justify-center gap-4 lg:mt-[0%] md:mt-[0%]"
      >
        <button
          id="prevPlans"
          class="px-4 py-2 rounded-full border border-[#8F4DEF] text-[#8F4DEF] hover:bg-[#8F4DEF] hover:text-white transition disabled:opacity-50 disabled:cursor-not-allowed"
          aria-label="Anterior"
        >
          Anterior
        </button>
        <div id="plan-dots" class="flex items-center gap-2">
          <button
            class="w-2.5 h-2.5 rounded-full bg-[#8F4DEF] opacity-100 scale-110 transition"
            data-index="0"
            aria-label="Página 1"></button>
          <button
            class="w-2.5 h-2.5 rounded-full bg-[#8F4DEF] opacity-40 transition"
            data-index="1"
            aria-label="Página 2"></button>
          <button
            class="w-2.5 h-2.5 rounded-full bg-[#8F4DEF] opacity-40 transition"
            data-index="2"
            aria-label="Página 3"></button>
        </div>
        <button
          id="nextPlans"
          class="px-4 py-2 rounded-full border border-[#8F4DEF] text-[#8F4DEF] hover:bg-[#8F4DEF] hover:text-white transition disabled:opacity-50 disabled:cursor-not-allowed"
          aria-label="Siguiente"
        >
          Siguiente
        </button>
      </div>
    </div>

    <!-- Terms -->
    <div
      class="text-center text-[#8F4DEF] text-lg space-y-1 mt-30 sm:mt-0 px-4"
    >
      <p>
        <strong>Para contratos de 12 meses:</strong> Activación e Instalación $99.99
        y Modem gratis.
      </p>
      <p>
        <strong>Para contratos de 24 meses:</strong> Activación, instalación y módem
        completamente gratis.
      </p>
      <p>
        <strong>Ciertas restricciones aplican.</strong>
      </p>
    </div>
    <!-- Contenedor para descripción 5G: se mostrará debajo de los términos -->
    <div
      id="plan-5g-paragraph"
      class="text-center text-[#8F4DEF] text-lg space-y-1 mt-6 sm:mt-4 px-4"
    >
    </div>
  </div>
</section>

<script>
  const pagesWrapper = document.getElementById("plan-pages");
  const pages = Array.from(pagesWrapper?.querySelectorAll("[data-page]") || []);
  const prevBtn = document.getElementById(
    "prevPlans",
  ) as HTMLButtonElement | null;
  const nextBtn = document.getElementById(
    "nextPlans",
  ) as HTMLButtonElement | null;
  const dots = Array.from(
    document.querySelectorAll("#plan-dots [data-index]"),
  ) as HTMLButtonElement[];
  const slogans = ["Fibra Óptica", "Wireless", "Plan 5G"];
  const sloganEl = document.getElementById(
    "plan-slogan",
  ) as HTMLParagraphElement | null;
  const paragraph5GHtml = `
    <hr />
    <p>
      <b>En Profiber nos esforzamos por ofrecerte el mejor servicio<br/>Para una experiencia transparente, te compartimos algunos detalles clave:</b>
      <br /><br/>
      Nos comprometemos a entregar la máxima velocidad posible dentro de nuestra red. Es importante saber que la velocidad efectiva puede variar debido a factores como la ubicación, la hora del día o el dispositivo utilizado. Las velocidades máximas anunciadas (ej. "hasta 250 Mbps") representan el potencial máximo de nuestra infraestructura, pero no son una garantía constante. En pruebas internas en nuestra área de cobertura, frecuentemente se alcanzan y superan estos valores.
      <br />
      Contrato de 12 o 24 meses, ideal si buscas la máxima rentabilidad. Incluye beneficios como instalación o equipo a costo reducido o gratuito, sujeto a un cargo por cancelación anticipada.
      <br />
      Cobertura: Nuestros servicios están disponibles en Puerto Rico donde nuestra infraestructura lo permita, priorizando el área oeste y noroeste (ej. Isabela, Aguadilla, Mayagüez). La disponibilidad exacta en tu dirección debe confirmarse, ya que la cobertura puede afectarse por condiciones locales y no está garantizada en todas las áreas.
      <br />
      ¿Tienes dudas? Nuestro equipo está para aclararlas.
      <br />
      Contáctanos para confirmar la cobertura en tu dirección exacta y conocer todos los detalles de los planes:
      <br />
      <b><a href="tel:+17878228820">(787) 822-8820</a></b>
    </p>
  `;
  const paragraph5GEl = document.getElementById(
    "plan-5g-paragraph",
  ) as HTMLDivElement | null;
  let current = 0;

  function render() {
    pages.forEach((el, i) => {
      if (i === current) {
        el.classList.remove("hidden");
      } else {
        el.classList.add("hidden");
      }
    });

    dots.forEach((dot, i) => {
      if (i === current) {
        dot.classList.add("opacity-100", "scale-110");
        dot.classList.remove("opacity-40");
      } else {
        dot.classList.remove("opacity-100", "scale-110");
        dot.classList.add("opacity-40");
      }
    });

    if (prevBtn) {
      prevBtn.disabled = current === 0;
    }
    if (nextBtn) {
      nextBtn.disabled = current === pages.length - 1;
    }

    if (sloganEl && slogans[current]) {
      sloganEl.innerHTML = slogans[current];
    }
    if (paragraph5GEl) {
      paragraph5GEl.innerHTML = current === 2 ? paragraph5GHtml : "";
    }
  }

  prevBtn?.addEventListener("click", () => {
    if (current > 0) {
      current -= 1;
      render();
    }
  });
  nextBtn?.addEventListener("click", () => {
    if (current < pages.length - 1) {
      current += 1;
      render();
    }
  });
  dots.forEach((dot, i) => {
    dot.addEventListener("click", () => {
      current = i;
      render();
    });
  });

  render();
</script>
